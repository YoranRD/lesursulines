---
import "../styles/global.css";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import StickyMobileCTA from "../components/layout/StickyMobileCTA.astro";
import { site, contact, hours, services } from "../data/site";
import { url, asset } from "../lib/url";

export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  pageType?: "website" | "article";
  canonicalPath?: string;
  includeRestaurantSchema?: boolean;
}

const {
  title,
  description = site.description,
  ogImage,
  pageType = "website",
  canonicalPath = Astro.url.pathname,
  includeRestaurantSchema = false,
} = Astro.props;

const fullTitle = title.includes(site.name) ? title : `${title} — ${site.name}`;
// Canonical avec trailing slash systématique pour cohérence de toutes les pages.
const normalizedPath = canonicalPath.endsWith("/") ? canonicalPath : `${canonicalPath}/`;
const canonical = new URL(normalizedPath, site.url).toString();
const ogImg = ogImage ?? asset("images/facade.webp");
const ogImageUrl = ogImg.startsWith("http") ? ogImg : `https://yoranrd.github.io${ogImg}`;

// JSON-LD Restaurant — sans aggregateRating tant que la source Google n'est pas validée.
const openingSpec = hours
  .filter((h) => !h.closed && h.slots && h.slots.length)
  .flatMap((h) =>
    (h.slots ?? []).map((slot) => {
      const [opens, closes] = slot.split("–").map((s) => s.trim().replace(/\s/g, ""));
      return {
        "@type": "OpeningHoursSpecification",
        dayOfWeek: h.schemaDay,
        opens: opens?.replace("h", ":") ?? "",
        closes: closes?.replace("h", ":") ?? "",
      };
    })
  );

const restaurantSchema = {
  "@context": "https://schema.org",
  "@type": "Restaurant",
  name: site.name,
  description: site.description,
  image: ogImageUrl,
  url: site.url,
  telephone: contact.phoneHref.replace(/^tel:/, ""),
  servesCuisine: services.cuisine,
  priceRange: services.priceRange,
  address: {
    "@type": "PostalAddress",
    streetAddress: contact.address.street,
    postalCode: contact.address.postalCode,
    addressLocality: contact.address.city,
    addressCountry: "FR",
  },
  openingHoursSpecification: openingSpec,
  sameAs: [contact.instagram],
  // TODO: aggregateRating non inclus tant que la source Google Business officielle n'est pas vérifiée.
};
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Favicon basé sur le logo officiel -->
    <link rel="icon" type="image/webp" href={asset("images/logo_ursulines.webp")} />

    <!-- Open Graph -->
    <meta property="og:type" content={pageType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Theme color -->
    <meta name="theme-color" content="#5e6a57" />

    <!-- Google Fonts: Cormorant Garamond + Source Sans 3 + Caveat -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;600&family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Source+Sans+3:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />

    {includeRestaurantSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(restaurantSchema)} />
    )}
  </head>
  <body>
    <a href="#main" class="skip-link">Aller au contenu</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <StickyMobileCTA />

    <script>
      // Reveal sobre — fade + translate, respect prefers-reduced-motion.
      if (
        typeof window !== "undefined" &&
        !window.matchMedia("(prefers-reduced-motion: reduce)").matches
      ) {
        const els = document.querySelectorAll<HTMLElement>(".reveal");
        if ("IntersectionObserver" in window && els.length) {
          const io = new IntersectionObserver(
            (entries) => {
              for (const e of entries) {
                if (e.isIntersecting) {
                  e.target.classList.add("is-visible");
                  io.unobserve(e.target);
                }
              }
            },
            { threshold: 0.12, rootMargin: "0px 0px -40px 0px" }
          );
          els.forEach((el) => io.observe(el));
        } else {
          els.forEach((el) => el.classList.add("is-visible"));
        }
      }
    </script>
  </body>
</html>
