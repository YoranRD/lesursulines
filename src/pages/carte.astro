---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import HoursCard from "../components/ui/HoursCard.astro";
import ContactCard from "../components/ui/ContactCard.astro";
import GinaMascot from "../components/ui/GinaMascot.astro";
import { asset, url } from "../lib/url";
import { contact } from "../data/site";
import { menuStructure, menuGuidelines, priceHint } from "../data/menu";
import { carteImages, menuCategoryImages } from "../data/images";
---

<BaseLayout
  title="Carte — Les Ursulines, restaurant vegan à Dieppe"
  description="Découvrez la carte des Ursulines : plats végétaliens du jour, desserts maison, boissons, petit déjeuner et brunch dominical à Dieppe."
>
  <section class="section section--cream">
    <div class="container">
      <div class="carte-intro">
        <div class="carte-intro__copy reveal">
          <span class="eyebrow">La carte</span>
          <h1>Une carte vivante, faite maison.</h1>
          <p class="lead">
            Les plats changent régulièrement, au rythme des saisons, du marché et des inspirations de la cheffe. La carte donne l'esprit de la maison ; pour une information précise avant votre venue, le plus simple est de nous contacter.
          </p>
          <ul class="guidelines">
            {menuGuidelines.map((g) => <li>{g}</li>)}
          </ul>
          <div class="cluster">
            <a class="btn" href={contact.phoneHref}>Appeler</a>
            <a class="btn btn--ghost" href={url("contact")}>Nous écrire</a>
          </div>
          <ul class="price-hint">
            {priceHint.map((line) => <li>{line}</li>)}
          </ul>
        </div>
        <figure class="carte-intro__figure reveal">
          <img
            src={asset(carteImages.concept.file)}
            alt={carteImages.concept.alt}
            loading="lazy"
            decoding="async"
          />
        </figure>
      </div>
    </div>
  </section>

  <section class="section section--paper">
    <div class="container">
      <div class="carte-grid">
        {menuStructure.map((bloc) => {
          const img = menuCategoryImages[bloc.id];
          return (
            <article class="carte-card reveal" id={bloc.id}>
              {img && (
                <figure class="carte-card__media">
                  <img
                    src={asset(img.file)}
                    alt={img.alt}
                    loading="lazy"
                    decoding="async"
                  />
                </figure>
              )}
              <div class="carte-card__body">
                <span class="eyebrow">{bloc.eyebrow}</span>
                <h2>{bloc.title}</h2>
                <p>{bloc.description}</p>
                {bloc.note && <p class="carte-card__note">{bloc.note}</p>}
                {bloc.id === "desserts" && (
                  <div class="carte-card__gina">
                    <GinaMascot variant="cake" size="sm" decorative={true} />
                  </div>
                )}
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <SectionHeading
        eyebrow="Carte indicative"
        title="Petit déjeuner, boissons et douceurs."
        lead="Cette carte donne un aperçu de ce qu'on retrouve souvent au comptoir. Les desserts du jour et les plats salés évoluent — pour une information précise, le mieux est de nous appeler."
      />
      <div class="carte-image-block">
        <figure class="carte-image-block__figure reveal">
          <img src={asset(carteImages.drinks.file)} alt={carteImages.drinks.alt} loading="lazy" decoding="async" />
          <figcaption>Carte des Ursulines.</figcaption>
        </figure>
        <div class="carte-image-block__legend-wrap">
          <ul class="carte-image-block__legend">
            <li>Cafés, expressos, lattés végétaux</li>
            <li>Thés, infusions et chaï</li>
            <li>Boissons fraîches et bissap maison selon saison</li>
            <li>Pâtisseries végétales, cookies, gâteaux du jour</li>
            <li>Plats du jour : appelez-nous pour les disponibilités</li>
          </ul>
          <GinaMascot
            variant="tea"
            size="sm"
            caption="Gina aime le petit déjeuner."
            class="carte-image-block__gina"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="section section--cream">
    <div class="container">
      <SectionHeading
        eyebrow="Avant de venir"
        title="Horaires et contact"
      />
      <div class="carte-bottom">
        <HoursCard />
        <ContactCard />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .lead {
    font-size: var(--fs-lead);
    color: var(--ink-soft);
  }

  .carte-intro {
    display: grid;
    gap: var(--space-6);
    align-items: center;
  }
  .carte-intro__copy {
    max-width: 62ch;
  }
  .carte-intro__figure {
    margin: 0;
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    background: var(--bg-paper);
  }
  .carte-intro__figure img {
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
  }
  @media (min-width: 880px) {
    .carte-intro {
      grid-template-columns: 1.05fr 0.95fr;
      gap: var(--space-8);
    }
    .carte-intro__figure img {
      aspect-ratio: 4 / 5;
    }
  }

  .guidelines {
    list-style: none;
    padding: 0;
    margin: var(--space-5) 0;
    display: grid;
    gap: 0.5rem;
  }
  .guidelines li {
    padding-left: 1.4rem;
    position: relative;
    color: var(--ink);
  }
  .guidelines li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.65rem;
    width: 8px;
    height: 8px;
    background: var(--olive);
    border-radius: 50%;
  }
  .price-hint {
    list-style: none;
    padding: 0;
    margin: var(--space-4) 0 0;
    font-family: var(--font-script);
    font-size: var(--fs-script-md);
    color: var(--olive-deep);
    line-height: 1.35;
    display: grid;
    gap: 0.15rem;
  }
  .price-hint li {
    margin: 0;
  }

  .carte-grid {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: 1fr;
  }
  .carte-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: var(--bg-paper);
    border: 1px solid var(--line-soft);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-sm);
  }
  .carte-card__media {
    margin: 0;
    overflow: hidden;
    background: var(--bg-soft);
  }
  .carte-card__media img {
    width: 100%;
    height: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    display: block;
    transition: transform var(--t-slow) var(--ease);
  }
  .carte-card:hover .carte-card__media img {
    transform: scale(1.02);
  }
  .carte-card__body {
    padding: clamp(1.5rem, 3vw, 2.2rem);
  }
  .carte-card h2 {
    margin-top: 0.4rem;
    font-size: 1.6rem;
  }
  .carte-card p {
    margin: 0.5rem 0;
    color: var(--ink-soft);
  }
  .carte-card__note {
    color: var(--ink);
    border-left: 3px solid var(--terracotta);
    padding-left: 0.75rem;
    margin-top: var(--space-3);
  }
  .carte-card__gina {
    margin-top: var(--space-4);
    display: flex;
    justify-content: flex-end;
  }
  @media (min-width: 720px) {
    .carte-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .carte-card:first-child {
      grid-column: 1 / -1;
      flex-direction: row;
    }
    .carte-card:first-child .carte-card__media {
      flex: 1 1 0;
      min-width: 0;
    }
    .carte-card:first-child .carte-card__media img {
      height: 100%;
      aspect-ratio: auto;
    }
    .carte-card:first-child .carte-card__body {
      flex: 1 1 0;
      min-width: 0;
      align-self: center;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .carte-card:hover .carte-card__media img {
      transform: none;
    }
  }

  .carte-image-block {
    display: grid;
    gap: var(--space-6);
  }
  .carte-image-block__figure {
    margin: 0;
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    background: var(--bg-paper);
  }
  .carte-image-block__figure img {
    width: 100%;
    height: auto;
    display: block;
  }
  .carte-image-block__figure figcaption {
    text-align: center;
    padding: 0.7rem;
    font-family: var(--font-script);
    color: var(--olive-deep);
    font-size: var(--fs-script-md);
    background: var(--bg-paper);
  }
  .carte-image-block__legend-wrap {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }
  .carte-image-block__legend {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.6rem;
  }
  .carte-image-block__legend li {
    padding: 0.65rem 0.9rem;
    background: var(--bg-paper);
    border: 1px solid var(--line-soft);
    border-radius: var(--radius-md);
    color: var(--ink);
  }
  .carte-image-block__gina {
    align-self: flex-end;
  }
  @media (min-width: 820px) {
    .carte-image-block {
      grid-template-columns: 1.1fr 1fr;
      align-items: start;
    }
  }

  .carte-bottom {
    display: grid;
    gap: var(--space-5);
  }
  @media (min-width: 760px) {
    .carte-bottom {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
