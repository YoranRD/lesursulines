---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import GinaMascot from "../components/ui/GinaMascot.astro";
import { contact } from "../data/site";
import { journalIdeas } from "../data/journal";
---

<BaseLayout
  title="Journal — Cuisine végétale, brunch et adresses vegan à Dieppe"
  description="Conseils, coulisses et inspirations autour de la cuisine végétale, du brunch, de Dieppe et de la culture aux Ursulines."
>
  <section class="section section--cream">
    <div class="container container--narrow">
      <div class="journal-hero">
        <div>
          <span class="eyebrow">Le journal</span>
          <h1>Cuisine végétale, brunch et adresses à Dieppe.</h1>
          <p class="lead">
            Le journal des Ursulines arrive prochainement. On y partagera des coulisses, des idées de brunchs vegan, des repères pour les voyageurs, des pistes pour bien manger végétal à Dieppe.
          </p>
          <p>
            En attendant, retrouvez-nous sur Instagram pour suivre la vie de la maison — le téléphone reste le moyen le plus simple pour nous joindre.
          </p>
          <div class="cluster">
            <a class="btn" href={contact.instagram} target="_blank" rel="noopener noreferrer">Suivre sur Instagram</a>
            <a class="btn btn--ghost" href={contact.phoneHref}>Appeler</a>
          </div>
        </div>
        <GinaMascot
          variant="smile-profile"
          size="sm"
          decorative={true}
          class="journal-hero__gina"
        />
      </div>
    </div>
  </section>

  <section class="section section--paper">
    <div class="container">
      <SectionHeading
        eyebrow="À venir"
        title="Quelques articles en préparation."
        lead="Aucun article publié pour l'instant — voici une liste des sujets qu'on a envie d'aborder."
      />
      <ul class="journal-grid">
        {journalIdeas.map((art) => (
          <li class="journal-card reveal">
            <span class="journal-card__cat">{art.category}</span>
            <h3>{art.title}</h3>
            <p>{art.excerpt}</p>
            <span class="journal-card__status">{art.status}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .lead {
    font-size: var(--fs-lead);
    color: var(--ink-soft);
  }
  .journal-hero {
    display: grid;
    gap: var(--space-5);
    align-items: end;
  }
  .journal-hero__gina {
    justify-self: center;
    opacity: 0.85;
  }
  @media (min-width: 640px) {
    .journal-hero {
      grid-template-columns: 1fr auto;
    }
    .journal-hero__gina {
      justify-self: end;
    }
  }
  .journal-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-4);
    grid-template-columns: 1fr;
  }
  .journal-card {
    padding: clamp(1.25rem, 3vw, 1.6rem);
    background: var(--bg-paper);
    border: 1px solid var(--line-soft);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .journal-card h3 {
    margin: 0;
    font-size: 1.3rem;
  }
  .journal-card p {
    margin: 0;
    color: var(--ink-soft);
  }
  .journal-card__cat {
    font-family: var(--font-script);
    color: var(--terracotta);
    font-size: 1rem;
  }
  .journal-card__status {
    margin-top: 0.4rem;
    align-self: flex-start;
    padding: 0.3rem 0.7rem;
    background: var(--bg-soft);
    border: 1px solid var(--line-soft);
    border-radius: var(--radius-pill);
    font-size: 0.8rem;
    color: var(--ink-soft);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  @media (min-width: 720px) {
    .journal-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1000px) {
    .journal-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
