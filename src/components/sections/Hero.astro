---
import { asset } from "../../lib/url";
import { url } from "../../lib/url";
import { contact } from "../../data/site";
import { heroImage, heroMobileImage } from "../../data/images";
---

<section class="hero">
  <div class="hero__media" aria-hidden="true">
    <picture>
      <source media="(max-width: 720px)" srcset={asset(heroMobileImage.file)} />
      <img
        src={asset(heroImage.file)}
        alt=""
        loading="eager"
        fetchpriority="high"
      />
    </picture>
    <div class="hero__veil"></div>
  </div>

  <div class="container hero__inner">
    <div class="hero__content reveal">
      <span class="eyebrow">Restaurant végétalien · Dieppe</span>
      <h1 class="hero__title">
        Un coffee shop végétal, généreux et vivant
        <span class="hero__title-script">sur le port de Dieppe.</span>
      </h1>
      <p class="hero__lead">
        Plats du jour faits maison, brunch du dimanche, desserts gourmands, thé et café — dans un lieu chaleureux où chacun a sa place.
      </p>
      <div class="cluster hero__ctas">
        <a class="btn" href={contact.phoneHref}>Appeler — réserver</a>
        <a class="btn btn--ghost" href={url("carte")}>Voir la carte</a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    min-height: clamp(520px, 80vh, 760px);
    display: flex;
    align-items: flex-end;
    color: var(--bg-cream);
    overflow: hidden;
  }
  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
  }
  .hero__media picture {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }
  .hero__media img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 68%;
  }

  .hero__veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(47, 51, 44, 0.28) 0%, rgba(47, 51, 44, 0.42) 50%, rgba(47, 51, 44, 0.86) 100%),
      linear-gradient(90deg, rgba(47, 51, 44, 0.55) 0%, rgba(47, 51, 44, 0.05) 70%);
  }
  .hero__inner {
    padding-block: clamp(2rem, 6vw, 4.5rem);
  }
  .hero__content {
    max-width: 640px;
  }
  .hero .eyebrow {
    color: #f3d6c8;
  }
  .hero .eyebrow::before {
    background: #f3d6c8;
  }
  .hero__title {
    font-family: var(--font-serif);
    font-size: var(--fs-display);
    line-height: 1.05;
    color: #fff;
    margin: 0.6rem 0 var(--space-4);
    letter-spacing: -0.01em;
  }
  .hero__title-script {
    display: block;
    font-family: var(--font-script);
    font-size: clamp(1.5rem, 3.5vw, 2.4rem);
    color: #f3d6c8;
    font-weight: 500;
    letter-spacing: 0;
    margin-top: 0.3rem;
  }
  .hero__lead {
    font-size: var(--fs-lead);
    color: rgba(255, 255, 255, 0.92);
    max-width: 52ch;
    margin: 0 0 var(--space-5);
  }
  .hero__ctas {
    margin-bottom: var(--space-5);
  }
  .hero .btn {
    background: var(--bg-cream);
    color: var(--ink);
  }
  .hero .btn--ghost {
    background: transparent;
    color: #fff;
    border-color: rgba(255, 255, 255, 0.5);
  }
  .hero .btn--ghost:hover {
    border-color: #fff;
    color: #fff;
  }
</style>
