---
import { galleryHome } from "../../data/images";
import GalleryGrid from "../ui/GalleryGrid.astro";
import SectionHeading from "../ui/SectionHeading.astro";
---

<section class="section section--cream" id="galerie">
  <div class="container">
    <SectionHeading
      eyebrow="Quelques images du lieu"
      title="Plats, ambiance et terrasse."
      lead="Toutes les photos sont prises chez nous. Voici les plats que vous pourrez découvrir en venant chez nous."
      align="center"
    />
    <GalleryGrid items={galleryHome} columns={3} ratio="square" />
  </div>
</section>
