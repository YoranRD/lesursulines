---
import { galleryHome } from "../../data/images";
import GalleryGrid from "../ui/GalleryGrid.astro";
import SectionHeading from "../ui/SectionHeading.astro";
---

<section class="section section--cream" id="galerie">
  <div class="container">
    <SectionHeading
      eyebrow="Quelques images du lieu"
      title="Plats du jour, douceurs et façade."
      lead="Toutes les photos sont prises chez nous. Pas d'images d'ailleurs : ce que vous voyez, c'est ce qu'on sert et l'endroit où on le sert."
      align="center"
    />
    <GalleryGrid items={galleryHome} columns={3} ratio="square" />
  </div>
</section>
