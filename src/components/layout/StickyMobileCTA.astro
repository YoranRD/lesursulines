---
import { contact } from "../../data/site";
import { url } from "../../lib/url";
---

<div class="sticky-cta" aria-label="Actions rapides">
  <div class="sticky-cta__inner">
    <a href={contact.phoneHref} aria-label="Appeler Les Ursulines">
      <svg viewBox="0 0 24 24" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.13 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/>
      </svg>
      <span>Appeler</span>
    </a>
    <a href={url("carte")}>
      <svg viewBox="0 0 24 24" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M3 6h18M3 12h18M3 18h12"/>
      </svg>
      <span>Carte</span>
    </a>
    <a href={contact.itineraryUrl} target="_blank" rel="noopener noreferrer" aria-label="Itinéraire vers Les Ursulines">
      <svg viewBox="0 0 24 24" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0 1 18 0z"/>
        <circle cx="12" cy="10" r="3"/>
      </svg>
      <span>Itinéraire</span>
    </a>
  </div>
</div>
