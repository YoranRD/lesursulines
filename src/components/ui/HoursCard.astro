---
import { contact } from "../../data/site";

export interface Props {
  variant?: "card" | "plain";
}
const { variant = "card" } = Astro.props;
---

<div class:list={["hours", { "hours--card": variant === "card" }]}>
  <div class="hours__highlight">
    <span class="eyebrow hours__highlight-label">Horaires</span>
    <p class="hours__highlight-text">
      <strong>Horaires variables selon la saison.</strong>
    </p>
  </div>
  <p class="hours__note">
    Les jours et heures d'ouverture sont actualisés sur Google. Pensez à vérifier avant votre venue.
  </p>
  <a
    class="btn btn--ghost hours__cta"
    href={contact.mapsUrl}
    target="_blank"
    rel="noopener noreferrer"
  >
    Voir sur Google
  </a>
</div>

<style>
  .hours {
    width: 100%;
  }
  .hours--card {
    background: var(--bg-paper);
    border: 1px solid var(--line-soft);
    border-radius: var(--radius-lg);
    padding: clamp(1.25rem, 3vw, 2rem);
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    height: 100%;
  }
  .hours__highlight {
    margin: 0 0 var(--space-3);
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .hours__highlight-label {
    align-self: flex-start;
  }
  .hours__highlight-text {
    margin: 0;
    font-size: 1.05rem;
    color: var(--ink);
    line-height: 1.45;
  }
  .hours__note {
    margin: 0 0 var(--space-4);
    color: var(--ink-soft);
    font-size: 0.95rem;
  }
  .hours__cta {
    align-self: flex-start;
    margin-top: auto;
  }
</style>
