---
import { asset } from "../../lib/url";
import type { LocalImage } from "../../data/images";

export interface Props {
  items: LocalImage[];
  columns?: 2 | 3 | 4;
  ratio?: "square" | "portrait" | "landscape" | "auto";
}
const { items, columns = 3, ratio = "square" } = Astro.props;
---

<ul class:list={["gallery", `gallery--c${columns}`, `gallery--${ratio}`]}>
  {items.map((img) => (
    <li class="gallery__item reveal">
      <img
        src={asset(img.file)}
        alt={img.alt}
        loading="lazy"
        decoding="async"
      />
    </li>
  ))}
</ul>

<style>
  .gallery {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-4);
  }
  .gallery--c2 { grid-template-columns: repeat(2, 1fr); }
  .gallery--c3 { grid-template-columns: repeat(2, 1fr); }
  .gallery--c4 { grid-template-columns: repeat(2, 1fr); }
  @media (min-width: 720px) {
    .gallery--c3 { grid-template-columns: repeat(3, 1fr); }
    .gallery--c4 { grid-template-columns: repeat(4, 1fr); }
  }
  .gallery__item {
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--bg-soft);
    box-shadow: var(--shadow-sm);
  }
  .gallery__item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--t-base) var(--ease);
  }
  .gallery__item:hover img {
    transform: scale(1.03);
  }
  .gallery--square .gallery__item { aspect-ratio: 1 / 1; }
  .gallery--portrait .gallery__item { aspect-ratio: 4 / 5; }
  .gallery--landscape .gallery__item { aspect-ratio: 4 / 3; }
  .gallery--auto .gallery__item { aspect-ratio: auto; }
</style>
