---
import { contact } from "../../data/site";

export interface Props {
  showItinerary?: boolean;
}
const { showItinerary = true } = Astro.props;
---

<div class="contact-card">
  <p class="contact-card__line">
    <span class="contact-card__label">Téléphone</span>
    <a href={contact.phoneHref} class="contact-card__phone">{contact.phone}</a>
  </p>
  <p class="contact-card__line">
    <span class="contact-card__label">Adresse</span>
    <span>{contact.address.full}</span>
  </p>
  <p class="contact-card__line">
    <span class="contact-card__label">Instagram</span>
    <a href={contact.instagram} target="_blank" rel="noopener noreferrer">
      {contact.instagramHandle}
    </a>
  </p>
  {showItinerary && (
    <div class="cluster contact-card__actions">
      <a class="btn" href={contact.phoneHref}>Appeler</a>
      <a class="btn btn--ghost" href={contact.itineraryUrl} target="_blank" rel="noopener noreferrer">
        Itinéraire
      </a>
    </div>
  )}
</div>

<style>
  .contact-card {
    background: var(--bg-paper);
    border: 1px solid var(--line-soft);
    border-radius: var(--radius-lg);
    padding: clamp(1.25rem, 3vw, 2rem);
    box-shadow: var(--shadow-sm);
  }
  .contact-card__line {
    margin: 0 0 var(--space-3);
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    font-size: 1rem;
  }
  .contact-card__label {
    font-family: var(--font-script);
    color: var(--terracotta);
    font-size: 1rem;
  }
  .contact-card__phone {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    color: var(--ink);
    text-decoration: none;
    letter-spacing: 0.01em;
  }
  .contact-card__phone:hover {
    color: var(--olive-deep);
  }
  .contact-card__actions {
    margin-top: var(--space-4);
  }
</style>
